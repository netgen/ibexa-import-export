{% extends '@ibexadesign/ui/layout.html.twig' %}

{% trans_default_domain 'import_export' %}

{% block breadcrumbs %}
    {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
        { value: 'breadcrumb.admin'|trans(domain='messages')|desc('Admin') },
        { value: 'netgen.ibexa_import_export.title'|trans|desc('Import/Export') },
    ]} %}
{% endblock %}

{% block header %}
    {% include '@ibexadesign/ui/page_title.html.twig' with {
        title: 'netgen.ibexa_import_export.title'|trans|desc('Import/Export'),
    } %}
{% endblock %}

{% block content %}
    <section class="container ibexa-container">
        <p><a class="btn btn-primary" href="{{ path('netgen_import_export.route.admin.import') }}">{{ 'netgen.ibexa_import_export.import'|trans|desc('Import') }}</a></p>
        <p><a class="btn btn-primary" href="{{ path('netgen_import_export.route.admin.export') }}">{{ 'netgen.ibexa_import_export.export'|trans|desc('Export') }}</a></p>
    </section>
{% endblock %}
