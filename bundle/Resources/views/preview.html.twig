<div id="import-details">
    <h2>Import details</h2>
    <h3>Structure: {{ import_structure }}</h3>
    <h3>Type: {{ import_mode }}</h3>
</div>

<div id="import-error-messages">
    {% if errors is defined and errors is not empty %}
        {% for error in errors %}
            <h3>{{ error }}</h3>
        {% endfor %}
    {% endif %}
</div>

<div id="import-skipped-content">
    {% if skipped_content is defined and skipped_content is not empty %}
        <h2>Skipped content</h2>
        {% for key, errors in skipped_content %}
            <h4>Content remote id: {{ key }}</h4>
            <ul>
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        {% endfor %}
    {% endif %}
</div>

<div id="import-skipped-fields">
    {% if skipped_content_fields is defined and skipped_content_fields is not empty %}
        <h2>Skipped fields</h2>
        {% for identifier, errors in skipped_content_fields %}
            <h3>Content remote id: {{ identifier }}</h3>
            <ul>
                {% for errorType, errorData in errors %}
                    <li><strong>{{ errorType }}</strong></li>
                    {% if errorData is iterable %}
                        <ul>
                            {% for errorMessage in errorData %}
                                <li>{{ errorMessage }}</li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <li>{{ errorData }}</li>
                    {% endif %}
                {% endfor %}
            </ul>
        {% endfor %}
    {% endif %}
</div>
