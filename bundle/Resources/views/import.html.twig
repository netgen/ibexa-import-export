{% extends "@ibexadesign/ui/layout.html.twig" %}

{% block breadcrumbs %}
    {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
        { value: 'breadcrumb.admin'|trans(domain='messages')|desc('Admin') },
        { value: 'netgen.ibexa_import_export.title'|trans|desc('Import/Export'), url: path('netgen_import_export.route.admin.index') },
        { value: 'netgen.ibexa_import_export.Import'|trans|desc('Import') }
    ]} %}
{% endblock %}

{% block header %}
    {{ include('@NetgenContentBrowser/page_head.html.twig') }}
    {% include '@ibexadesign/ui/page_title.html.twig' with {
        title: 'netgen.ibexa_import_export.Import'|trans|desc('Import'),
    } %}
{% endblock %}

{% block content %}
    <div id="import-preview"></div>
    {{ form_start(form) }}
    {{ form_row(form.package) }}
    {{ form_row(form.parent_location) }}
    <input id="import-preview-button" type="submit" class="btn btn-primary" value="{{ 'netgen.ibexa_import_export.Import'|trans|desc('Import') }}" />
    {{ form_end(form) }}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var packageInput = document.querySelector('input[type="file"]');
            var previewDiv = document.querySelector('#import-preview');
            var previewButton = document.querySelector('#import-preview-button');

            packageInput.addEventListener('change', function() {
                var formData = new FormData();
                formData.append('file', packageInput.files[0]);

                var xhr = new XMLHttpRequest();
                xhr.open('POST', '{{ path('netgen_import_export.route.admin.ajax.preview') }}', true);
                xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                xhr.onreadystatechange = function () {
                    if (xhr.readyState === XMLHttpRequest.DONE) {
                        if (xhr.status === 200) {
                            previewDiv.innerHTML = xhr.responseText;

                            previewButton.disabled = false;
                            previewButton.style.opacity = 1;
                        } else {
                            previewDiv.innerHTML = xhr.responseText;
                            previewButton.disabled = true;
                            previewButton.style.opacity = 0.5;
                        }
                    }
                };
                xhr.send(formData);
            });
        });
    </script>

{% endblock %}
